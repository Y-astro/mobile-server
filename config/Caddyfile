{
    admin unix//data/data/com.termux/files/home/.config/caddy/admin.sock
	auto_https disable_redirects
	servers {
		enable_full_duplex
		timeouts {
			read_body 0s
			read_body_idle 60s
			read_header 60s
			write 0s
			write_idle 60s
			idle 120s
		}
	}
}

(portal_body) {
	encode zstd gzip
	request_header -X-Music-User
	request_header -Remote-User

    @portalPages path / /login /api/login /api/logout
    header @portalPages {
        Cache-Control "no-store, private"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }

    handle /wealth-ca.crt {
        root * /data/data/com.termux/files/home/.config/caddy/public
        rewrite * /RedmiHomeServerCA.crt
        file_server
    }

    handle /portal.css {
        root * /data/data/com.termux/files/home/.config/dashboard/static
        file_server
    }

    @appearanceAssets path /theme-tokens.css /appearance.css /appearance.js
    handle @appearanceAssets {
        root * /data/data/com.termux/files/home/.config/dashboard/static
        header Cache-Control "no-cache"
        file_server
    }

    handle /drive/static/custom.css {
        root * /data/data/com.termux/files/home/.config/dashboard/static
        rewrite * /filebrowser.css
        header Cache-Control "no-cache"
        file_server
    }

    handle /wealth* {
        redir https://{host}:8444/wealth/ 303
    }

	handle /drive/static/assets/index-BqkXVoMb.js {
		root * /data/data/com.termux/files/home/.config/dashboard/static
		rewrite * /filebrowser-entry.js
		header Cache-Control "no-cache"
		file_server
	}

	handle /drive/static/assets/mobile-filebrowser.js {
		root * /data/data/com.termux/files/home/.config/dashboard/static
		rewrite * /patched_index.js
		header Cache-Control "no-cache"
		file_server
	}

	handle /drive/branding/* {
		reverse_proxy 127.0.0.1:8081
	}

    handle /drive/api/raw/* {
        forward_auth 127.0.0.1:8001 {
            uri /api/auth-check
            copy_headers X-Forwarded-User
        }
        reverse_proxy 127.0.0.1:8081 {
            flush_interval 20ms
            @activeContent {
                header Content-Type text/html*
                header Content-Type image/svg+xml*
                header Content-Type application/xhtml+xml*
                header Content-Type application/xml*
                header Content-Type text/xml*
                header Content-Type application/javascript*
                header Content-Type text/javascript*
            }
            handle_response @activeContent {
                header {
                    >Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
                    >Content-Disposition attachment
                    >X-Content-Type-Options nosniff
                }
                copy_response
            }
            transport http {
                keepalive 90s
                response_header_timeout 300s
                read_buffer 131072
                write_buffer 131072
            }
        }
    }

    redir /drive /drive/ 308

	handle /drive* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check
			copy_headers X-Forwarded-User
		}
		reverse_proxy 127.0.0.1:8081 {
			flush_interval 20ms
			transport http {
				keepalive 90s
				response_header_timeout 300s
				read_buffer 131072
				write_buffer 131072
			}
		}
	}

	handle /laptop* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
		}
		reverse_proxy 127.0.0.1:7683
	}

	handle /terminal* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
		}
		reverse_proxy 127.0.0.1:7681
	}

	handle /agy* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
		}
		reverse_proxy 127.0.0.1:7682
	}

	handle /vault* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
		}
		uri strip_prefix /vault
		reverse_proxy 127.0.0.1:8082
	}

	redir /music /music/ 308

	# Browser entry point for music: same-origin bootstrap and state sync
	@musicBrowserEntry {
		path /music/
		header Cookie *session_token*
	}
	handle @musicBrowserEntry {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Native client bypass routes: ONLY when NO portal session cookie is present!
	# 1. Native Subsonic API
	@musicSubsonicNative {
		path /music/rest/*
		not header Cookie *session_token*
	}
	handle @musicSubsonicNative {
		reverse_proxy 127.0.0.1:4533 {
			header_up -X-Music-User
			header_up -Remote-User
		}
	}

	# 2. Native password login (Feishin native mode)
	@musicPortalLogin {
		method POST
		path /music/auth/login
		header Cookie *session_token*
	}
	handle @musicPortalLogin {
		forward_auth 127.0.0.1:8001 {
			uri /api/music-auth-check
		}
		respond "Use your portal login for music." 403
	}

	@musicLoginNative {
		method POST
		path /music/auth/login
		not header Cookie *session_token*
	}
	handle @musicLoginNative {
		reverse_proxy 127.0.0.1:4533 {
			header_up -X-Music-User
			header_up -Remote-User
		}
	}

	# 3. Native bearer token on music paths (Feishin native API)
	@musicBearerNative {
		path /music/api/* /music/events/*
		header x-nd-authorization *
		not header Cookie *session_token*
	}
	handle @musicBearerNative {
		reverse_proxy 127.0.0.1:4533 {
			header_up -X-Music-User
			header_up -Remote-User
		}
	}

	# All other /music routes (browser SSO, portal cookie requests, or anonymous browser)
	handle /music/* {
		uri query -jwt
		forward_auth 127.0.0.1:8001 {
			uri /api/music-auth-check
			copy_headers X-Music-User
		}
		reverse_proxy 127.0.0.1:4533 {
			header_up -Cookie
			header_up -x-nd-authorization
			header_up -Authorization
			header_up -Remote-User
		}
	}

	redir /suwayomi /suwayomi/ 308

	@mangaThumbnail path_regexp thumb ^/suwayomi/api/v1/manga/([0-9]+)/thumbnail$
	handle @mangaThumbnail {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
			copy_headers X-Forwarded-User
		}
		root * /data/data/com.termux/files/home/suwayomi/data/downloads/thumbnails
		@hasThumb file /{re.thumb.1}.webp /{re.thumb.1}.jpg /{re.thumb.1}.png /{re.thumb.1}.jpeg /{re.thumb.1}.avif
		handle @hasThumb {
			rewrite * {http.matchers.file.relative}
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			reverse_proxy 127.0.0.1:4569 {
				header_down Cache-Control "public, max-age=31536000, immutable"
				flush_interval 20ms
				transport http {
					keepalive 90s
					response_header_timeout 300s
					read_buffer 131072
					write_buffer 131072
				}
			}
		}
	}
	@graphqlPost {
		method POST
		path /suwayomi/api/graphql
	}
	handle @graphqlPost {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
			copy_headers X-Forwarded-User
		}
		reverse_proxy 127.0.0.1:4566
	}

	handle /suwayomi* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
			copy_headers X-Forwarded-User
		}
		reverse_proxy 127.0.0.1:4569 {
			header_down Cache-Control "no-cache, no-store, must-revalidate"
			flush_interval 20ms
			transport http {
				keepalive 90s
				response_header_timeout 300s
				read_buffer 131072
				write_buffer 131072
			}
		}
	}

	handle /screenshots/* {
		forward_auth 127.0.0.1:8001 {
			uri /api/auth-check-admin
		}
		root * /data/data/com.termux/files/home
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8001 {
			header_up X-Real-IP {remote_host}
		}
	}
}

