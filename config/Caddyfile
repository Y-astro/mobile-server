https://192.168.1.8:8444, https://192.168.1.10:8444, https://100.75.159.53:8444, https://redmi-k20-pro.tail939a82.ts.net:8444 {
    tls internal
    encode zstd gzip
    header {
        ?Cache-Control "no-store, private, max-age=0"
        Pragma "no-cache"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy same-origin
        -Server
        -Access-Control-Allow-Origin
        -Access-Control-Allow-Credentials
    }
    redir / /wealth/ 303
    redir /login https://{host}:8443/login 303
    redir /portal https://{host}:8443/ 303
    handle /wealth/* {
        route {
            request_body {
                max_size 52MB
            }
            forward_auth 127.0.0.1:8001 {
                uri /api/auth-check
            }
            reverse_proxy 127.0.0.1:18930 {
                header_up X-Real-IP {remote_host}
                flush_interval 20ms
            }
        }
    }
    # Wealthfolio offline status page
    handle_errors {
        header Cache-Control "no-store, private"
        header Content-Type "text/html; charset=utf-8"
        header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'"
        respond `<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Wealthfolio · Laptop unavailable</title><style>body{margin:0;background:#111210;color:#eeede6;font:16px system-ui;min-height:100vh;display:grid;place-items:center;padding:24px;box-sizing:border-box}main{max-width:480px;padding:32px;border:1px solid #626558;border-radius:18px;background:#1b1c18}p{line-height:1.65;color:#b7b9ad}a{display:inline-block;margin:12px 12px 0 0;padding:12px 16px;border-radius:8px;background:#d5e8d5;color:#142417;text-decoration:none}.quiet{background:transparent;color:#d5e8d5;border:1px solid #626558}</style><main><p>WEALTHFOLIO · LAPTOP CONNECTION</p><h1>The laptop is not connected</h1><p>It may be asleep, restarting, or Wealthfolio may be switched off. Ask the laptop owner to start Wealthfolio and keep the laptop awake, then try again.</p><p>Your statements and processing results stay saved on the laptop. This page does not show a cached financial copy.</p><a href="/wealth/">Try again</a><a class="quiet" href="/portal">Back to home server</a></main></html>` 503
    }
}


# Reject unknown Wealthfolio Host headers without issuing on-demand certificates.
https://:8444 {
    tls internal
    header {
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        -Server
    }
    respond "Unrecognized Wealthfolio host." 421
}

