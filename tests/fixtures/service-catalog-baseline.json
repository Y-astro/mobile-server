  "dashboard_services_config": {
    "filebrowser": {
      "id": "filebrowser",
      "name": "Cloud Storage & Media",
      "category": "Storage & Media",
      "port": 8085,
      "pattern": "filebrowser -d",
      "start_cmd": [
        "proot-distro",
        "login",
        "debian",
        "--bind",
        "/storage/emulated/0:/storage/emulated/0",
        "--",
        "filebrowser",
        "-d",
        "/data/data/com.termux/files/home/.config/filebrowser/filebrowser.db",
        "-a",
        "127.0.0.1",
        "-c",
        "/data/data/com.termux/files/home/.config/filebrowser/fb_config.json"
      ],
      "icon": "folder",
      "desc": "Family Cloud Storage, Photos, Music & Google Files-style Media Engine",
      "open_url": "/drive/",
      "open_label": "Master Drive",
      "can_toggle": true
    },
    "suwayomi": {
      "id": "suwayomi",
      "name": "Suwayomi Manga Server",
      "category": "Storage & Media",
      "port": 4567,
      "pattern": "Suwayomi-Server",
      "start_cmd": [
        "proot-distro",
        "login",
        "debian",
        "--bind",
        "/storage/emulated/0:/storage/emulated/0",
        "--",
        "/usr/bin/java",
        "-Xms128m",
        "-Xmx512m",
        "-Djava.awt.headless=true",
        "-Dsuwayomi.tachidesk.config.server.rootDir=/data/data/com.termux/files/home/suwayomi/data",
        "-jar",
        "/data/data/com.termux/files/home/suwayomi/bin/Suwayomi-Server.jar"
      ],
      "icon": "book-open",
      "desc": "Self-Hosted Manga & Comic Library with Tachiyomi/Mihon Cloud Sync (Port 4567)",
      "open_url": "/suwayomi/",
      "open_label": "Open Reader",
      "can_toggle": true
    },
