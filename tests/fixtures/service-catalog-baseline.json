{
  "supervisor_default": {
    "ssh": {
      "port": 8022,
      "cmd": [
        "/data/data/com.termux/files/usr/bin/sshd",
        "-D"
      ]
    },
    "dashboard": {
      "port": 8001,
      "path": "/healthz",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/python3",
        "-u",
        "/data/data/com.termux/files/usr/bin/dashboard"
      ]
    },
    "caddy": {
      "port": 8000,
      "path": "/healthz",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/caddy",
        "run",
        "--config",
        "/data/data/com.termux/files/home/.config/caddy/Caddyfile"
      ]
    },
    "filebrowser": {
      "port": 8085,
      "path": "/drive/",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/filebrowser",
        "-d",
        "/data/data/com.termux/files/home/.config/filebrowser/filebrowser.db",
        "-a",
        "127.0.0.1",
        "-p",
        "8085",
        "-c",
        "/data/data/com.termux/files/home/.config/filebrowser/fb_config.json",
        "--cacheDir",
        "/data/data/com.termux/files/home/.cache/filebrowser",
        "--disableImageResolutionCalc",
        "--imageProcessors",
        "2"
      ]
    },
    "transfer_gateway": {
      "port": 8081,
      "path": "/healthz",
      "cmd": [
        "/data/data/com.termux/files/home/bin/mobile-gateway",
        "-backend",
        "http://127.0.0.1:8085"
      ]
    },
    "adguard": {
      "port": 3000,
      "path": "/",
      "cmd": [
        "/data/data/com.termux/files/home/adguard/AdGuardHome/AdGuardHome",
        "-c",
        "/data/data/com.termux/files/home/adguard/data/AdGuardHome.yaml",
        "-w",
        "/data/data/com.termux/files/home/adguard/data",
        "--no-permcheck",
        "--no-etc-hosts"
      ]
    },
    "syncthing": {
      "port": 8384,
      "path": "/rest/noauth/health",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/syncthing",
        "serve",
        "--config",
        "/data/data/com.termux/files/home/.local/state/syncthing",
        "--data",
        "/data/data/com.termux/files/home/.local/state/syncthing",
        "--allow-newer-config",
        "--no-browser"
      ]
    },
    "vaultwarden": {
      "port": 8082,
      "path": "/alive",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/proot-distro",
        "login",
        "debian",
        "--",
        "/usr/bin/env",
        "ROCKET_PORT=8082",
        "ROCKET_ADDRESS=127.0.0.1",
        "DATA_FOLDER=/data/data/com.termux/files/home/vaultwarden/data",
        "WEB_VAULT_FOLDER=/data/data/com.termux/files/home/vaultwarden/web-vault",
        "/data/data/com.termux/files/home/vaultwarden/vaultwarden"
      ]
    },
    "terminal": {
      "port": 7681,
      "path": "/terminal/",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/ttyd",
        "-W",
        "-i",
        "127.0.0.1",
        "-p",
        "7681",
        "-b",
        "/terminal",
        "-I",
        "/data/data/com.termux/files/home/.config/ttyd/termux_index.html",
        "/data/data/com.termux/files/home/bin/termux_session.sh"
      ]
    },
    "agy": {
      "port": 7682,
      "path": "/agy/",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/ttyd",
        "-W",
        "-a",
        "-m",
        "8",
        "-i",
        "127.0.0.1",
        "-p",
        "7682",
        "-b",
        "/agy",
        "-I",
        "/data/data/com.termux/files/home/.config/ttyd/agy_index.html",
        "/data/data/com.termux/files/home/bin/agy_session.sh"
      ]
    },
    "laptop_terminal": {
      "port": 7683,
      "path": "/laptop/",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/ttyd",
        "-W",
        "-a",
        "-m",
        "8",
        "-i",
        "127.0.0.1",
        "-p",
        "7683",
        "-b",
        "/laptop",
        "/data/data/com.termux/files/usr/bin/python3",
        "/data/data/com.termux/files/home/bin/laptop_session.py"
      ]
    },
    "tor": {
      "port": 9050,
      "protocol": "socks5",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/tor",
        "-f",
        "/data/data/com.termux/files/home/.config/tor/torrc"
      ]
    },
    "suwayomi": {
      "port": 4569,
      "path": "/suwayomi/",
      "cmd": [
        "/data/data/com.termux/files/home/bin/start_suwayomi.sh"
      ]
    },
    "suwayomi_filter": {
      "port": 4566,
      "path": "/healthz",
      "cmd": [
        "/data/data/com.termux/files/usr/bin/python3",
        "/data/data/com.termux/files/home/bin/suwayomi_graphql_filter.py"
      ]
    },
    "battery_guard": {
      "cmd": [
        "/data/data/com.termux/files/usr/bin/bash",
        "/data/data/com.termux/files/home/bin/battery_guard.sh",
        "--daemon"
      ]
    }
  },
